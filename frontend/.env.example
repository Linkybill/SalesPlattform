# local/dev; ax42-1/dev uses https://176.9.57.203:3003.
VITE_API_BASE_URL=https://127.0.0.1:3003
# Required for direct Vite: copy PlatformApi and TenantPortal from the resolved
# identity-platform URL profile. Kubernetes supplies deployment-config.js.
VITE_PLATFORM_API_BASE_URL=
VITE_TENANT_PORTAL_URL=
# Vite's port alone does not configure HTTPS or the platform runtime profile.
# Zoho OAuth runs through the backend. No Zoho credentials belong here.
